{
  "schema_version": 1,
  "protocol_id": "FEDCORE-IJAR-V34-PACS-PROSPECTIVE-HSB-v1",
  "primary_file": "PRIMARY_512_REP000.csv",
  "primary_key": ["model_id", "procedure"],
  "expected_primary_rows": 90,
  "required_columns": {
    "model_id": "string",
    "architecture": "enum[resnet18,convnext_tiny]",
    "split": "integer[0,4]",
    "nominal_training_seed": "integer[0,2]",
    "checkpoint_sha256": "hex64",
    "proposal_seal_sha256": "hex64",
    "audit_sequence_sha256": "hex64",
    "count_tensor_sha256": "hex64",
    "procedure": "enum[H,S,B]",
    "alpha": "float=0.2",
    "delta_r": "float=0.05",
    "delta_c": "float=0.05",
    "mixture_set": "string=Delta^3",
    "budget_total": "integer=512",
    "replicate_id": "integer=0",
    "proposal_feasible_members": "integer[0,12]",
    "certified": "boolean",
    "selected_candidate": "integer[-1,11]",
    "selected_score": "string_or_empty",
    "selected_gamma": "float_or_empty",
    "selected_threshold": "float_or_empty",
    "risk_decision": "boolean",
    "risk_ucb": "float_or_empty; empty for H",
    "raw_p_value": "float_or_empty; required for selected H member",
    "holm_adjusted_p_value": "float_or_empty; required for selected H member",
    "coverage_lcb": "float[0,1]",
    "ECA": "float[0,1]",
    "refusal_reason": "enum[none,proposal_infeasible,accepted_count,risk,width,coverage_zero,model_failure]",
    "full_frame_truth_opened_after_primary_hash": "boolean",
    "true_worst_client_risk": "float_or_empty",
    "true_min_client_acceptance": "float_or_empty",
    "validity_failure": "boolean_or_empty"
  },
  "count_file": {
    "name": "PRIMARY_COUNTS.csv.gz",
    "primary_key": ["model_id", "candidate_index", "client"],
    "expected_rows": 1440,
    "ordering_constraint": "0 <= K <= A <= n",
    "same_tensor_for_H_S_B": true
  },
  "mandatory_ledgers": [
    "MODEL_STATUS.csv",
    "PROPOSAL_FAMILY_MANIFEST.csv.gz",
    "PRIMARY_COUNTS.csv.gz",
    "PRIMARY_512_REP000.csv",
    "DENOMINATOR_LEDGER.json",
    "FAILURE_LEDGER.csv",
    "SECONDARY_AUDIT_REPLICATES.csv.gz",
    "INDEPENDENT_REPLAY.json",
    "FINAL_VALIDATION.json",
    "NEGATIVE_RESULTS.md",
    "SHA256SUMS.txt"
  ]
}
